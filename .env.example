# Configuração de exemplo — sem segredos. Copie para .env (lido por `npm start`) ou exporte no
# shell antes de `npm run dev`. Todas as variáveis são opcionais.

# --- servidor de produção (npm start) ---
PORT=8080
# 0.0.0.0 para aceitar conexões externas (atrás de um proxy reverso, de preferência)
HOST=127.0.0.1
# 1 somente quando houver proxy reverso confiável: o IP do cliente passa a vir de X-Forwarded-For
CONFIAR_PROXY=0

# --- pedidos de acesso/anúncio (SQLite local, node:sqlite) ---
# arquivo do banco; padrão dados/privado/pedidos.sqlite (fora do versionamento)
PEDIDOS_ARQUIVO=
# dias de retenção dos contatos; expurgo na inicialização e a cada hora
PEDIDOS_RETENCAO_DIAS=180
# envios permitidos por IP a cada 10 minutos (por e-mail: 3 por hora, fixo)
PEDIDOS_LIMITE_IP=5
# sal do hash de origem gravado com cada pedido; sem ele, um valor aleatório por execução.
# Gere o seu (ex.: openssl rand -hex 32) e não o versione.
PEDIDOS_SAL=

# --- simulação (?fonte=simulacao) ---
# minutos simulados por minuto real (o ciclo vai de 16h52 a 03h30 do dia seguinte e recomeça)
SIM_VELOCIDADE=10
# fixa o relógio simulado em minutos desde 00:00 de 04/10/2026 (ex.: 1250 = 20h50)
SIM_T_FIXO=
# instante real (ms desde 1970) em que o ciclo simulado começa; vazio = início do processo.
# 0 deixa o relógio igual em processos diferentes (a função da Vercel usa 0)
SIM_ANCORA=

# --- fotos das candidaturas ---
# 1 = não buscar no TSE; serve só o que já está em dados-brutos/fotos (iniciais como reserva)
FOTOS_OFFLINE=0

# --- coletor ao vivo (npm run coletor) ---
# segundos entre consultas aos agregados do TSE
TSE_INTERVALO=30
